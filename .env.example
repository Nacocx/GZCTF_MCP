# Copy to .env, then pass its absolute path using GZCTF_ENV_FILE.
GZCTF_BASE_URL=http://localhost:8080
GZCTF_WORKSPACE=/Users/nax/Code/GZCTF_MCP
# Raw GZCTF_Token or a full Cookie header (including chunk cookies when present).
# Credentials belong only in your local .env, never in conversation or committed client configuration.
GZCTF_ADMIN_COOKIE=
GZCTF_PLAYER_COOKIE=
# Optional credential login. Used when no Cookie is configured, or by auth_login.
# Expired Cookies require explicit auth_login; writes never retry automatically.
GZCTF_ADMIN_USERNAME=
GZCTF_ADMIN_PASSWORD=
GZCTF_PLAYER_USERNAME=
GZCTF_PLAYER_PASSWORD=
GZCTF_TIMEOUT=30
GZCTF_MAX_FILE_BYTES=104857600

# Source checkout auto-detects the CLI installed by scripts/install_wsrx.py.
# Override for packaged installations or a custom upstream CLI location:
# GZCTF_WSRX_BINARY=/absolute/path/to/wsrx
GZCTF_MAX_TUNNELS=8
